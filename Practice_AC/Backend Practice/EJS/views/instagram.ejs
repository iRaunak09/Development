<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
    <link href="/style.css" rel="stylesheet">
</head>
<body>
    <h1>Welcome to instagram @<%= data.name %></h1>
    <button>Follow</button>
    <button>Message</button>

    <!-- <h3>Follower's List</h3> -->
    <h4>No of followers: <%= data.followers %></h4>
    <h4>Following: <%= data.following %></h4>
    <hr>
    
    <h4>Posts</h4>
    <% for(post of data.posts){%>
        <img src = <%= post.image %> alt="some image">
        <p>Likes: <%= post.likes%> &nbsp &nbsp&nbsp&nbsp&nbsp &nbsp&nbsp  Comments: <%= post.comments%></p>
        <!-- <p>No. of comments: <%= post.comments%></p> -->
    <% }%>
    
</body>
</html>